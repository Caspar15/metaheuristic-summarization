# ---------------------------------------------------------------------------
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.key

# Claude Code machine-local settings (permissions allowlist etc.)
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Logs / model artifacts
# ---------------------------------------------------------------------------
*.log
*.joblib
*.pkl
*.pt
*.bin
*.safetensors

# ---------------------------------------------------------------------------
# Datasets — never commit. Download via scripts/0_download_data.py
#
# NOTE: a bare `data` entry would ignore the directory itself, which makes any
# `!data/samples/...` allowlist impossible (git cannot re-include a file inside
# an excluded directory). So ignore the CONTENTS and then re-include samples.
# ---------------------------------------------------------------------------
data/*
!data/samples/
!data/.gitkeep

# ---------------------------------------------------------------------------
# Experiment outputs — regenerate, don't commit
# ---------------------------------------------------------------------------
runs/*
!runs/README.md
!runs/.gitkeep

# Local archives produced by the cleanup plan
*.tar.gz
*.zip

# ---------------------------------------------------------------------------
# Archived / superseded material — kept on local disk, NOT in version control.
#
# These are historical trial-and-error configs, scripts and run outputs from
# before the IEEE Access refactor. They are not current specifications and no
# active code depends on them. Keeping them out of git keeps the repo readable
# for collaborators; the local copies remain untouched.
#
# Excluded here: configs/_legacy_archive (101 files), scripts/_archive (18).
# Already excluded via data/* and runs/*: data/processed/_archive_legacy,
# data/_legacy_archive, runs/_archive_2026_01_15.
# ---------------------------------------------------------------------------
**/_archive/
**/_archive_*/
**/_legacy_archive/
**/_legacy_*/
**/_generated/

# ---------------------------------------------------------------------------
# NLP local caches
# ---------------------------------------------------------------------------
nltk_data/

# ---------------------------------------------------------------------------
# Node (demo frontend only)
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/

# runs_v2: exclude bulk artifacts, keep the small evidence files
runs_v2/**/predictions.jsonl
runs_v2/**/per_example.jsonl
